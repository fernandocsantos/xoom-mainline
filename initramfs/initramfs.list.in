# Lista para usr/gen_init_cpio (CONFIG_INITRAMFS_SOURCE)
dir /dev 755 0 0
nod /dev/console 600 0 0 c 5 1
nod /dev/null 666 0 0 c 1 3
dir /bin 755 0 0
dir /etc 755 0 0
dir /proc 755 0 0
dir /sys 755 0 0
dir /tmp 1777 0 0
file /init @XOOM@/initramfs/init 755 0 0
file /bin/busybox @XOOM@/initramfs/busybox 755 0 0
slink /bin/sh busybox 777 0 0
file /bin/xoom-check @XOOM@/initramfs/xoom-check 755 0 0
file /etc/udhcpd.conf @XOOM@/initramfs/udhcpd.conf 644 0 0
# Firmware do Bluetooth BCM4329 (o hci_bcm o pede aos ~1,7 s, antes do rootfs)
dir /lib 755 0 0
dir /lib/firmware 755 0 0
dir /lib/firmware/brcm 755 0 0
file /lib/firmware/brcm/BCM4329B1.hcd @XOOM@/kernel-hw/firmware/BCM4329B1.hcd 644 0 0
